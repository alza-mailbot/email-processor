# Copy to .env and fill in the values. The application reads all
# configuration from environment variables (a local .env is auto-loaded).

# Path to the Gmail OAuth token file (required); create it with
# 'uv run python scripts/authorize.py'
GMAIL_TOKEN_PATH=token.json

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Base URL of the chatbot service (required); local dev runs it on port 8080
CHATBOT_URL=http://localhost:8080

# Budget for one chatbot call in seconds
# CHATBOT_TIMEOUT_SECONDS=120

# Fully qualified Pub/Sub topic the Gmail watch publishes to (required)
PUBSUB_TOPIC=projects/<project-id>/topics/gmail-notifications

# GCP project id, read directly by google libraries, not by our settings.
# Only local docker needs it; the host's gcloud config and the Cloud Run
# metadata server supply the project on their own.
GOOGLE_CLOUD_PROJECT=<project-id>

# Renew the Gmail watch (and run the catch-up sweep) when the app starts
# RENEW_WATCH_ON_STARTUP=false

# Processing state backend: 'file' (local development) or 'firestore' (cloud, needs ADC)
# STATE_BACKEND=file

# State file location for the file backend
# STATE_FILE_PATH=.state.json

# Attach Google identity tokens to chatbot calls (needed on Cloud Run only)
# CHATBOT_AUTH=false
